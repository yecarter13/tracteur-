<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rewrite storage packages to the real folder
    RewriteRule ^storage/packages/(.*)$ storage/app/public/packages/$1 [L]

    # Serve uploaded storage files from the real folder (the public/storage symlink is not followed by the web server)
    RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

    # Serve existing static FILES that live in the public/ subfolder
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Block direct access to sensitive FILES
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|tests|vendor|\.env) - [F,L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
